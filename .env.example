# ========================================================
# VeloBot 2.0 - 公路车技师与频道主专属机器人配置
# ========================================================

# 1. Telegram 机器人核心凭据 (通过 @BotFather 获取)
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_bot_token

# 2. 频道与群组 ID
# 频道 ID (例如 @YourRoadBikeChannel 或 -100xxxxxxxxxx)，用于推送新视频广播
CHANNEL_ID=@YourRoadBikeChannel

# 讨论群 ID (例如 -100xxxxxxxxxx)，用于新车友入群公路车常识验证
GROUP_ID=-1001234567890

# 3. 管理员配置
# 你的个人 Telegram 数字 ID (可通过 @userinfobot 或 @RawDataBot 获取)
# 机器人会向此 ID 发送：新视频物料绑定提醒、车友异响门诊投稿、每日数据库备份文件
ADMIN_ID=987654321

# 4. YouTube 频道配置
# 你的 YouTube 频道 ID (例如 UCxxxxxxxxxxxxxxxxxxxxxx)
# 可在 YouTube 后台或频道主页网址中获取
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# 5. 可选扩展配置
# 检查 YouTube 更新间隔（分钟，默认 10）
CHECK_INTERVAL_MINUTES=10
